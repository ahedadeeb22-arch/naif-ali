# ============================================================================
# نموذج متغيرات البيئة — أسماء فقط، لا أسرار حقيقية.
# انسخ إلى .env.local (محلي) أو أضف القيم في Vercel / Supabase Dashboard.
# ============================================================================

# --- Supabase (public; آمن للمتصفح لكنه مقيد بـRLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase server secret (NEVER prefix with NEXT_PUBLIC_, never in client bundle) ---
# مطلوب فقط للأوامر الإدارية الخادمية (إنشاء مستخدم/دعوات). لا يُستورد في مكونات عميل.
SUPABASE_SERVICE_ROLE_KEY=
# حماية endpoint الإدارة: مفتاح داخلي يستخدمه cron/عمليات الخادم فقط.
INTERNAL_ADMIN_SECRET=

# --- App config (public, non-secret) ---
NEXT_PUBLIC_APP_NAME=نظام الخضروات
NEXT_PUBLIC_APP_TIMEZONE=Asia/Riyadh
NEXT_PUBLIC_CURRENCY=SAR
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Feature switches (default off in production) ---
NEXT_PUBLIC_SHOW_DEV_BANNER=false
